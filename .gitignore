# Python
__pycache__/
*.py[cod]
*.pyc

# 本地凭证 (切勿提交!)
.env
cookies.txt
*.cookie

# 机器人状态 (记账文件, 每台机器各自一份)
.bot_state.json
.wm_counter.json
.wm_ledger.json
.wm_quota.json
.wm_outage.json
# 账本备份 (损坏时用于恢复, 同样是本机私有)
.wm_ledger.json.bak

# WorkBuddy 运行时数据 (自动化记忆/日志, 本机私有)
.workbuddy/

# 系统
.DS_Store
Thumbs.db

# 多账号: 每个账号一份凭证 (accounts/README.md 要保留)
accounts/*.env

# 按账号档案隔离的状态目录
.state/

# 巡检器的本地状态 (已发布基线 / CHANGELOG 指纹, 各机一份)
.probe_published.json
.probe_changelog_key
