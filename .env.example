# Pickcat 工具配置样例。复制为 .env 后填入你自己的账号。
# 注意: 本文件含密码, 切勿提交到公开仓库。

# 登录账号 (编程猫社区账号邮箱)
PICKCAT_USERNAME=you@example.com

# 登录密码
PICKCAT_PASSWORD=your-password

# ---- 人机验证绕过 (Cookie 模式, 推荐) ----
# 若密码登录有人机验证, 改为用浏览器 Cookie:
#   1) 浏览器正常登录 pickcat
#   2) F12 -> Network -> 任意一条请求 -> Request Headers -> 复制整串 cookie 值
#   3) 粘到下面 (分号分隔的 kv 对)
# PICKCAT_COOKIE=session=xxxx; sid=yyyy; ...
# 或用 Netscape 格式 cookies.txt (浏览器插件导出):
# PICKCAT_COOKIE_FILE=cookies.txt
# Cookie 模式下, 上面的 USERNAME/PASSWORD 可留空。Cookie 会过期, 失效后重拷一次。

# (可选) API 根地址。默认 https://cdsq.dao3.fun
# 若官方换了主机, 请在浏览器 Network 里核对后改这里。
# PICKCAT_BASE=https://cdsq.dao3.fun

# (可选) 写操作最小间隔(秒), 防止太快被风控。默认 5。
# PICKCAT_MIN_INTERVAL=5
